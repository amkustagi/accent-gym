{
  "name": "speakco",
  "private": true,
  "version": "0.0.12",
  "appVersion": "0.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-mediapipe.mjs && node scripts/gen-sw.mjs",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:app": "tsc -b && vite build && node scripts/copy-mediapipe.mjs",
    "cap:sync": "npm run build:app && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@mediapipe/tasks-vision": "1.1.1",
    "@revenuecat/purchases-capacitor": "^13.7.6",
    "@supabase/supabase-js": "2.117.2",
    "html-to-image": "1.11.13",
    "idb-keyval": "6.2.1",
    "kokoro-js": "1.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.8"
  }
}
